{
  "name": "one-punch-devkit",
  "private": true,
  "version": "0.5.11",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:spine-notes": "vite --config spine-metadata-app/vite.config.ts",
    "dev:spine-notes:electron": "npm run build:spine-notes && electron spine-metadata-app/electron/main.mjs",
    "build": "tsc -b && vite build",
    "build:spine-notes": "tsc -p spine-metadata-app/tsconfig.json && vite build --config spine-metadata-app/vite.config.ts",
    "build:spine-notes:mac": "npm run build:spine-notes && electron-builder --config spine-metadata-app/electron-builder.json --mac dir",
    "release:spine-notes:mac": "npm run build:spine-notes && electron-builder --config spine-metadata-app/electron-builder.json --mac zip",
    "build:spine-notes:win": "npm run build:spine-notes && electron-builder --config spine-metadata-app/electron-builder.json --win dir --x64",
    "release:spine-notes:win": "npm run build:spine-notes && electron-builder --config spine-metadata-app/electron-builder.json --win portable --x64",
    "build:electron": "npm run build && electron-builder",
    "build:electron:mac": "npm run build && electron-builder --mac",
    "release:mac": "node scripts/release-mac.mjs",
    "release:mac:publish": "node scripts/release-mac.mjs --publish",
    "update:keygen": "node scripts/create-update-key.mjs",
    "test:updater": "node --test scripts/update-security.test.mjs",
    "build:electron:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.12.0",
    "eslint": "^10.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "build": {
    "appId": "com.superapp.app",
    "productName": "One Punch DevKit",
    "artifactName": "One-Punch-DevKit-${version}-${arch}-${os}.${ext}",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "vi"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/update-public.pem",
        "to": "assets/update-public.pem"
      },
      {
        "from": "assets/install-update.sh",
        "to": "assets/install-update.sh"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "one-punch-devkit-extension",
        "to": "one-punch-devkit-extension"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "ChauNgoanBacHo",
      "repo": "new-cocos-tools",
      "releaseType": "release"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "One Punch DevKit <onepunchtools@users.noreply.github.com>",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3",
    "postcss": "^8.4.49",
    "preline": "^2.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1"
  }
}
