{
  "name": "cocos-internal-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build && electron-builder",
    "build:electron:mac": "npm run build && electron-builder --mac",
    "release:mac": "rm -rf release && npm run build && electron-builder --mac dir && node scripts/package-mac-release.mjs && node scripts/cleanup-mac-release.mjs",
    "build:electron:linux": "npm run build && electron-builder --linux",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "eslint": "^10.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  },
  "build": {
    "appId": "com.superapp.app",
    "productName": "CocosTools",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "vi"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dir"
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "CocosTools <cocostools@users.noreply.github.com>",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.3",
    "postcss": "^8.4.49",
    "preline": "^2.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1"
  }
}
